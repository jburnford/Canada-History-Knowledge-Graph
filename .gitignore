# =============================================================================
# HGIS Canada Knowledge Graph — gitignore
#
# Inputs to the pipeline are checked in (scripts/, cd_links_output/,
# year_links_output/) or come from outside the repo (the GDB and Excel files
# at config.data_root). Outputs are derived and stay out of git.
# =============================================================================

# ---- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
*.egg-info/
dist/
build/
*.swp
*.swo

# ---- Editor / OS -----------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
.conda/

# ---- User-local config + scratch ------------------------------------------
config.local.toml
sandbox/
.claude/

# ---- Source data (large; lives at config.data_root, not in repo) ----------
*.zip
*.xlsx
*.xls
*.gdb/
TCP_CANADA_CSD_202306/
# Per-year Excel folders (1851/.../1901/) and the 1911/1921 tables zip
1851/
1861/
1871/
1881/
1891/
1901/
1911Tables/
1921Tables/

# ---- Generated outputs (rebuild via `make all`) ---------------------------
# Static site
rag_site/
# KuzuDB / Ladybug pilot DB (the *.kuzu binary is large and rebuildable)
pilot/on_kuzu/*.kuzu
*.kuzu
# Neo4j census v2 backup (stale snapshot, regenerate from data)
neo4j_census_v2.bak/
# Excel-vs-GDB diff sidecars
data_quality/
# 1881 TCP residents pipeline output (Borealis deposit derived)
residents_1881_output/
# Old generation paths
generated/
neo4j_census_test/
# Logs
canonical_names.log
build_cidoc_crm.log
link_all_years.log

# ---- Generated RDF (Turtle exports) ---------------------------------------
*.ttl
*.rdf
*.dump

# ---- Volatile caches (rebuilt by their respective scripts) ----------------
data/wd_person_places_cache.json
data/geonames_misses.csv

# ---- Top-level scratch / one-shot debugging artifacts ---------------------
# Move to sandbox/ if you need to keep them; otherwise they regenerate from
# the underlying data.
analysis_*.py
analysis_*.json
april*.md
build_visualization_data.py
census_visualization.html
visualization_data.json
csd_disambig_input.csv
canonical_cd_names.csv
cd_wikidata_matches.csv
wikidata_grounding/csd_disambig_queue.jsonl
wikidata_grounding/v1t1_1911_*.csv

# ---- Whitelist guards (re-include things accidentally caught above) -------
!CLAUDE.md
!CENSUS*.md
!README.md
!requirements.txt
!config.toml
!scripts/*.py
!scripts/*.sh

# ---- Research audit trails (research/) ------------------------------------
# Keep memos, scripts, outputs and public-domain census page images.
# Exclude: scratch archives/extractions, databases over GitHub size limits,
# bulk re-downloadable census volumes, and third-party copyrighted article
# captures (HTML/PDF copies of publisher-hosted literature must not be
# republished in a public repo).
research/**/*.zip
research/**/*_extracted/
research/**/*.duckdb
research/**/*.html
research/1851_quebec_measurement_audit_20260907/external_sources/census_1851_volume2.pdf
research/1851_quebec_measurement_audit_20260907/**/mcinnis_1981.pdf
research/1851_quebec_measurement_audit_20260907/**/thibeault_1989.pdf
research/1851_quebec_measurement_audit_20260907/**/bond_2026_supplement.pdf
research/1921_prairie_sex_balance_20260907/external_sources/census_1921_volume1.pdf
research/1921_prairie_sex_balance_20260907/external_sources/census_1929_origins.pdf
research/1881_family_origins_20260907/sources/census1881_vol1_download/
research/1881_family_origins_20260907/sources/census1881_vol1.pdf
research/1881_family_origins_20260907/sources/census1881_vol1_ia.pdf
research/1881_family_origins_20260907/sources/gauvreau_thornton_vezina_2010.pdf
research/1881_family_origins_20260907/sources/taylor_2016.pdf
